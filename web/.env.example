# Copy to .env.local for local dev. On Railway, set these under Service → Variables.
# NEXT_PUBLIC_* are inlined at BUILD time (redeploy after changing them).
NEXT_PUBLIC_LENS_READER=0x8C1E90549DAd239a1661f8E107D1Db8C0fD3902e
NEXT_PUBLIC_MARKET_FACTORY=0x9484889951FCde41BE56C5bDE93EAFfaa98D15eE
NEXT_PUBLIC_MARKETS=0x6F16DDDc77b14129C2ae50Bd4aD079eec3243c1A
NEXT_PUBLIC_EXPLORER=https://explorer.testnet.chain.robinhood.com
# Server-only RPC (may contain a provider key). Never prefix with NEXT_PUBLIC_.
RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Mainnet (Robinhood Chain 4663) · dual mode: FHE adapter interface, plaintext today ---
# Leave ALL of these empty until a real 4663 deployment exists. Mainnet appears in the
# network selector only when lens reader, factory, markets and explorer are all set.
NEXT_PUBLIC_MAINNET_LENS_READER=
NEXT_PUBLIC_MAINNET_MARKET_FACTORY=
# Comma separated market addresses
NEXT_PUBLIC_MAINNET_MARKETS=
NEXT_PUBLIC_MAINNET_EXPLORER=
# Server-only mainnet RPC (may contain a provider key). Never prefix with NEXT_PUBLIC_.
MAINNET_RPC_URL=
# Set to true only after a published audit of the deployed contracts.
NEXT_PUBLIC_AUDITED=false
